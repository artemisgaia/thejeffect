# ────────────────────────────────────────────────────────────────
# THE J EFFECT — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
# ────────────────────────────────────────────────────────────────

# Stripe keys (get from https://dashboard.stripe.com/apikeys)
# Use test keys (sk_test_ / pk_test_) for development
# Use live keys (sk_live_ / pk_live_) for production
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# Your site URL — used for Stripe redirect URLs
# In development: http://localhost:3000
# In production: https://thejeffect.com (or your Vercel domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
