# ────────────────────────────────────────────────────────────────
# THE J EFFECT — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git. Set the same values in Vercel
# (Project → Settings → Environment Variables) for production.
# ────────────────────────────────────────────────────────────────

# Site URL — used for Stripe redirects and share images
# Development: http://localhost:3000   ·   Production: https://thejeffect.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe (https://dashboard.stripe.com/apikeys) ───────────────
# Use sk_test_ keys in development and sk_live_ keys in production.
# Prices come from the catalog/admin, so no Stripe Price IDs are needed.
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# ── Supabase (Project Settings → API) ───────────────────────────
# Powers the admin dashboard, product edits, photo uploads and the
# subscriber list. First run supabase/schema.sql in the SQL editor,
# then create your admin user (Authentication → Users) and add its
# email to the admins table (see the top of schema.sql).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
# Server only. Lets newsletter sign-ups be saved. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Resend — email marketing (https://resend.com/api-keys) ──────
RESEND_API_KEY=re_YOUR_API_KEY
# Segment that holds subscribers (Resend → Audience → Segments)
RESEND_SEGMENT_ID=YOUR_SEGMENT_ID
# Must be on a domain you have verified in Resend
RESEND_FROM="The J Effect <hello@thejeffect.com>"
RESEND_REPLY_TO=hello@thejeffect.com

# ── Formspree — contact form (https://formspree.io) ─────────────
# The ID from your form endpoint: https://formspree.io/f/THIS_PART
FORMSPREE_FORM_ID=YOUR_FORMSPREE_FORM_ID
